generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TipoCampanha {
  id        Int        @id @default(autoincrement())
  descricao String
  status    String  
  
  campanhas Campanha[]

  @@map("tipo_campanha")
}

model Campanha {
  id               Int      @id @default(autoincrement())
  nome             String
  dt_inicio        DateTime
  dt_fim           DateTime
  taxa_operacional Float
  valor_bolao      Float
  codigo_campanha  String   @unique
  status           String
  
  tipo_campanha_id Int
  tipo_campanha    TipoCampanha @relation(fields: [tipo_campanha_id], references: [id])
  
  opcoes           CampanhaOpcoes[]

  @@map("campanha")
}

model CampanhaOpcoes {
  id                 Int      @id @default(autoincrement())
  descricao          String
  eh_resultado_final Boolean  @default(false)
  status             String
  
  campanha_id        Int
  campanha           Campanha @relation(fields: [campanha_id], references: [id])
  
  apostas            ApostaBolao[]

  @@unique([campanha_id, descricao])
  @@map("campanha_opcoes")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  cpf          String   @unique
  email        String   @unique
  telefone     String?
  tipo_usuario String?  
  senha        String
  status       String
  
  apostas      ApostaBolao[]

  @@map("usuario")
}

model MeioPagamento {
  id        Int      @id @default(autoincrement())
  descricao String
  status    String
  
  apostas   ApostaBolao[]

  @@map("meio_pagamento")
}

model ApostaBolao {
  id                Int      @id @default(autoincrement())
  dt_criacao        DateTime @default(now())
  comprovante       String?
  status            String
  
  usuario_id        Int
  usuario           Usuario @relation(fields: [usuario_id], references: [id])
  
  meio_pagamento_id Int
  meio_pagamento    MeioPagamento @relation(fields: [meio_pagamento_id], references: [id])
  
  campanha_opcao_id Int
  campanha_opcao    CampanhaOpcoes @relation(fields: [campanha_opcao_id], references: [id])

  @@map("aposta_bolao")
}