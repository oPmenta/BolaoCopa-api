datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model usuario {
  id           String   @id @default(uuid())
  nome         String
  cpf          String   @unique
  email        String   @unique
  telefone     String
  tipo_usuario String   @default("USER")
  senha        String
  status       String   @default("ATIVO")
  criadoEm     DateTime @default(now())

  apostas      aposta[]
}

model tipo_campanha {
  id        String     @id @default(uuid())
  descricao String
  campanhas campanha[]
}

model campanha {
  id               String          @id @default(uuid())
  nome             String
  dt_inicio        DateTime
  dt_fim           DateTime
  taxa_operacional Float
  valor_bolao      Float
  codigo_campanha  String          @unique
  status           String          @default("ABERTA")
  criadoEm         DateTime        @default(now())
  
  tipo_campanha_id String
  tipo_campanha    tipo_campanha   @relation(fields: [tipo_campanha_id], references: [id])
  opcoes           campanha_opcao[]
}

model campanha_opcao {
  id                 String   @id @default(uuid())
  campanha_id        String
  campanha           campanha @relation(fields: [campanha_id], references: [id])
  descricao          String
  status             String   @default("ATIVO")
  eh_resultado_final Boolean  @default(false)

  apostas            aposta[]

  @@unique([campanha_id, descricao])
}

model meio_pagamento {
  id        String   @id @default(uuid())
  descricao String
  apostas   aposta[]
}

model aposta {
  id                String         @id @default(uuid())
  usuario_id        String
  usuario           usuario        @relation(fields: [usuario_id], references: [id])
  campanha_opcao_id String
  campanha_opcao    campanha_opcao @relation(fields: [campanha_opcao_id], references: [id])
  meio_pagamento_id String
  meio_pagamento    meio_pagamento @relation(fields: [meio_pagamento_id], references: [id])
  
  dt_criacao        DateTime       @default(now())
  status            String         @default("PENDENTE")
  comprovante       String?
}